        neura.store_indexed %7 to [%4 : !neura.data<index, i1>]  {dfg_id = 17 : i32, latency = 1 : i32, mapping_locs = [{id = 16 : i32, index_per_ii = 1 : i32, invalid_iterations = 1 : i32, resource = "tile", time_step = 3 : i32, x = 1 : i32, y = 3 : i32}], rhs_value = "%input0"} : !neura.data<i32, i1>
