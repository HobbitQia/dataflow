          %11 = "neura.add"(%10) {dfg_id = 8 : i32, rhs_value = 1 : index} : (!neura.data<index, i1>) -> !neura.data<index, i1>
          %12 = neura.load_indexed [%8, %11 : !neura.data<index, i1>, !neura.data<index, i1>]  {dfg_id = 15 : i32, lhs_value = "%input2"} : !neura.data<i32, i1>
          %13 = neura.load_indexed [%11 : !neura.data<index, i1>]  {dfg_id = 14 : i32, lhs_value = "%input1"} : !neura.data<i32, i1>
          %14 = "neura.mul"(%13, %12) {dfg_id = 19 : i32} : (!neura.data<i32, i1>, !neura.data<i32, i1>) -> !neura.data<i32, i1>
          %15 = neura.load_indexed [%8, %10 : !neura.data<index, i1>, !neura.data<index, i1>]  {dfg_id = 7 : i32, lhs_value = "%input2"} : !neura.data<i32, i1>
          %16 = neura.load_indexed [%10 : !neura.data<index, i1>]  {dfg_id = 6 : i32, lhs_value = "%input1"} : !neura.data<i32, i1>
          %17 = "neura.mul"(%16, %15) {dfg_id = 13 : i32} : (!neura.data<i32, i1>, !neura.data<i32, i1>) -> !neura.data<i32, i1>
          %18 = "neura.add"(%9, %17) {dfg_id = 18 : i32} : (!neura.data<i32, i1>, !neura.data<i32, i1>) -> !neura.data<i32, i1>
          %19 = neura.load_indexed [%8 : !neura.data<index, i1>]  {dfg_id = 4 : i32, lhs_value = "%input0"} : !neura.data<i32, i1>
          %20 = "neura.add"(%19, %14) {dfg_id = 20 : i32} : (!neura.data<i32, i1>, !neura.data<i32, i1>) -> !neura.data<i32, i1>
