        %30 = "neura.data_mov"(%29) {dfg_id = 58 : i32, mapping_locs = [{id = 192 : i32, index_per_ii = 2 : i32, invalid_iterations = 1 : i32, per_tile_register_id = 0 : i32, resource = "register", time_step = 7 : i32}]} : (!neura.data<i32, i1>) -> !neura.data<i32, i1>
        neura.store_indexed %30 to [%6, %17 : !neura.data<index, i1>, !neura.data<index, i1>]  {dfg_id = 59 : i32, latency = 1 : i32, mapping_locs = [{id = 6 : i32, index_per_ii = 3 : i32, invalid_iterations = 1 : i32, resource = "tile", time_step = 8 : i32, x = 2 : i32, y = 1 : i32}], rhs_value = "%input4"} : !neura.data<i32, i1>
